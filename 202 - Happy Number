class Solution {
    public boolean isHappy(int n) {
        int sum = n;
        while(sum != 1 && sum != 4){
            int temp = sum;
            int squareSum = 0;
            while(temp > 0){
                int digit = temp % 10;
                squareSum += digit * digit;
                temp /= 10;
            }
            sum = squareSum;
        }
        return sum == 1; 
    }
}
