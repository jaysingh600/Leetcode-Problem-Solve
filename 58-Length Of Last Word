class Solution {
    public int lengthOfLastWord(String s) {

        // String[] words = s.trim().split(" ");
        // String lastWord = words[words.length - 1];
        // int count=lastWord.length();
        // return count;

        s=s.trim();
        int count=0;
        for(int i=s.length()-1;i>=0;i--){
            if(s.charAt(i)!=' '){
                count++;
            }else{
                break;
            }
        }
        return count;
        
    }
}
