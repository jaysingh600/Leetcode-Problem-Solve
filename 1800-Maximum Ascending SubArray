class Solution {
    public int maxAscendingSum(int[] nums) {
        int max = Integer.MIN_VALUE;
        int n = nums.length;
        for (int i =0; i < n; i++) {
            int sum = nums[i];
             max = Math.max(max, sum);
            for (int j = i+1; j < n; j++) {
                if (nums[j] > nums[j - 1]) {
                    sum += nums[j];
                    max = Math.max(max, sum);
                }else{
                    break;
                }
            }
        }
        return max;
    }
}
