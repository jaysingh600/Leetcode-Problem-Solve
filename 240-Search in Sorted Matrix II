class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        // int r=matrix.length;
        // int c=matrix[0].length;
        // for(int i=0;i<r;i++){
        //     for(int j=0;j<c;j++){
        //         if(matrix[i][j]==target){
        //             return true;
        //         }
        //     }
        // }
        // return false;
        
        // optimized approach
        int r=0;
        int c=matrix[0].length-1;
        while(r < matrix.length && c >= 0){
            if(matrix[r][c]==target){
                return true;
            }else if(matrix[r][c]> target){
                c--;
            }else{
                r++;
            }
        }
        return false;
    }
}
