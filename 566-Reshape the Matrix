class Solution {
    public int[][] matrixReshape(int[][] mat, int r, int c) {
        int n=mat.length;
        int m=mat[0].length;
        if (n * m != r * c) {            
            return mat;
        }
         int result[][] = new int[r][c];
         for (int i = 0; i < n * m; i++) {
            int newRow = i / c;
            int newCol = i % c;
            int oldRow = i / m;
            int oldCol = i % m;
            result[newRow][newCol] = mat[oldRow][oldCol];
        }
        return result;
    }
}
