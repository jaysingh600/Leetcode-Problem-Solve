class Solution {

    class TrieNode {
        TrieNode[] child = new TrieNode[26];
        int idx;
    }

    TrieNode root = new TrieNode();

    public int[] stringIndices(String[] wordsContainer, String[] wordsQuery) {

        int best = 0;

        // Find globally smallest word index
        for (int i = 1; i < wordsContainer.length; i++) {
            if (wordsContainer[i].length() < wordsContainer[best].length() ||
               (wordsContainer[i].length() == wordsContainer[best].length() && i < best)) {
                best = i;
            }
        }

        root.idx = best;

        // Build Trie using reversed traversal
        for (int i = 0; i < wordsContainer.length; i++) {
            insert(wordsContainer[i], i, wordsContainer);
        }

        int[] ans = new int[wordsQuery.length];

        for (int i = 0; i < wordsQuery.length; i++) {
            ans[i] = search(wordsQuery[i]);
        }

        return ans;
    }

    private void insert(String word, int index, String[] wordsContainer) {

        TrieNode node = root;

        for (int i = word.length() - 1; i >= 0; i--) {

            int c = word.charAt(i) - 'a';

            if (node.child[c] == null) {
                node.child[c] = new TrieNode();
                node.child[c].idx = index;
            }

            node = node.child[c];

            int curr = node.idx;

            if (wordsContainer[index].length() < wordsContainer[curr].length() ||
               (wordsContainer[index].length() == wordsContainer[curr].length() && index < curr)) {
                node.idx = index;
            }
        }
    }

    private int search(String word) {

        TrieNode node = root;

        for (int i = word.length() - 1; i >= 0; i--) {

            int c = word.charAt(i) - 'a';

            if (node.child[c] == null) {
                break;
            }

            node = node.child[c];
        }

        return node.idx;
    }
}
