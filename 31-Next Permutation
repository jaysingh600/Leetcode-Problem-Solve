class Solution {
    public void nextPermutation(int[] arr) {
        int n = arr.length;
        int pivot = -1;
        // Step 1: Find the pivot from right to left
        for (int i = n - 2; i >= 0; i--) {
            if (arr[i] < arr[i + 1]) {
                pivot = i;
                break;
            }
        }
        // Step 2: If no pivot exists, reverse the entire array
        if (pivot == -1) {
            reverse(arr, 0, n - 1);
            return;
        }
        // Step 3: Find the first element greater than pivot from right
        for (int i = n - 1; i > pivot; i--) {
            if (arr[i] > arr[pivot]) {
                int temp = arr[i];
                arr[i] = arr[pivot];
                arr[pivot] = temp;
                break;
            }
        }
        // Step 4: Reverse all elements after the pivot
        reverse(arr, pivot + 1, n - 1);
    }
    private void reverse(int[] arr, int left, int right) {
        while (left < right) {
            int temp = arr[left];
            arr[left] = arr[right];
            arr[right] = temp;
            left++;
            right--;
        }
    }
}
